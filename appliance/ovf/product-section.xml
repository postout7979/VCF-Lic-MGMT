<!--
  OVF ProductSection fragment - defines the vApp Properties that show up
  as input fields in vSphere's "Deploy OVF Template" wizard (the same
  mechanism VCSA/NSX Manager/etc. use).

  This is NOT a standalone file you deploy as-is. It must be merged into
  the <VirtualSystem> element of a real, exported .ovf descriptor -
  normally placed right after <OperatingSystemSection> and before
  <VirtualHardwareSection> (order matters to some OVF validators; both
  vCenter's own export and the OVF spec put ProductSection after the OS
  section). See ../README.md "Step 3" for exactly how to merge it.

  Prerequisite on the source VM (set this BEFORE exporting with ovftool,
  either via the vSphere Client "VM > Edit Settings > vApp Options", or
  by exporting and hand-editing as done here): the OVF environment
  transport must include "com.vmware.guestInfo" so these properties are
  delivered to the guest via VMware Tools' guestinfo.* namespace. That's
  the vCenter/vApp Options default, but double check it on whatever
  source VM you export from.
-->
<ProductSection ovf:required="false" xmlns="http://schemas.dmtf.org/ovf/envelope/1" xmlns:ovf="http://schemas.dmtf.org/ovf/envelope/1">
  <Info>Guest OS network/identity customization for VCF License Management</Info>
  <Product>VCF License Management</Product>
  <Vendor>Broadcom</Vendor>
  <Version>1.0</Version>

  <Category>1 Networking Properties</Category>

  <Property ovf:key="guestinfo.hostname" ovf:type="string" ovf:userConfigurable="true" ovf:value="vcf-lic-mgmt">
    <Label>Hostname</Label>
    <Description>Guest OS hostname. Applied on first boot only.</Description>
  </Property>

  <Property ovf:key="guestinfo.ipaddress" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
    <Label>IP Address</Label>
    <Description>Static IPv4 address. Leave blank to keep DHCP (netmask/gateway below are then ignored).</Description>
  </Property>

  <Property ovf:key="guestinfo.netmask" ovf:type="string" ovf:userConfigurable="true" ovf:value="255.255.255.0">
    <Label>Subnet Mask</Label>
    <Description>IPv4 subnet mask, e.g. 255.255.255.0.</Description>
  </Property>

  <Property ovf:key="guestinfo.gateway" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
    <Label>Default Gateway</Label>
    <Description>IPv4 default gateway address.</Description>
  </Property>

  <Property ovf:key="guestinfo.dns" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
    <Label>DNS Servers</Label>
    <Description>Comma-separated DNS server IP addresses, e.g. 10.0.0.1,10.0.0.2.</Description>
  </Property>

  <Property ovf:key="guestinfo.dnssearch" ovf:type="string" ovf:userConfigurable="true" ovf:value="">
    <Label>DNS Search Domains</Label>
    <Description>Comma-separated DNS search domains, e.g. corp.example.com.</Description>
  </Property>

  <Property ovf:key="guestinfo.ntp" ovf:type="string" ovf:userConfigurable="true" ovf:value="pool.ntp.org">
    <Label>NTP Servers</Label>
    <Description>Comma-separated NTP server addresses/hostnames.</Description>
  </Property>

  <Category>2 Authentication Properties</Category>

  <Property ovf:key="guestinfo.rootpw" ovf:type="password" ovf:password="true" ovf:userConfigurable="true" ovf:value="">
    <Label>Root Password</Label>
    <Description>Initial root password. Leave blank to keep the image's built-in default (not recommended for anything beyond a lab).</Description>
  </Property>
</ProductSection>

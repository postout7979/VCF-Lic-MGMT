[Unit]
Description=VCF License Management (docker compose stack)
Requires=docker.service
After=docker.service network-online.target ovf-customize.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vcf-lic-mgmt/appliance/docker
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
